# Runtime mode / security
# APP_MODE=demo keeps seeded demo data and no-login fallback available.
# APP_MODE=production requires explicit login sessions and fail-closed defaults.
APP_MODE=demo
SEED_DEMO_DATA=
CORS_ALLOW_ORIGINS=
COOKIE_SECURE=
COOKIE_SAMESITE=lax
MAX_REQUEST_BODY_BYTES=1048576
SSO_ALLOWED_DOMAINS=
SSO_AUTO_PROVISION=false

# LLM
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
AZURE_AI_API_KEY=
AZURE_AI_API_BASE=
CUSTOM_API_KEY=
CUSTOM_API_BASE=
CUSTOM_PROVIDER_TYPE=
CUSTOM_API_VERSION=
CUSTOM_TEMPERATURE=
CUSTOM_MAX_TOKENS=
DEFAULT_MODEL=
# Ticket intelligence embeddings are opt-in to avoid surprise token spend.
# Requires pgvector-capable Postgres and an embedding-capable provider.
TICKET_EMBEDDING_ENABLED=false
TICKET_EMBEDDING_MODEL=openai/text-embedding-3-small
TICKET_EMBEDDING_DIMENSIONS=1536
TICKET_EMBEDDING_TIMEOUT_SECONDS=30
TICKET_EMBEDDING_MAX_CHARS=32000
TICKET_VECTOR_MIN_SCORE=0.25
TICKET_EMBEDDING_API_BASE=
# Private/internal notes are excluded from external embeddings by default.
TICKET_INDEX_PRIVATE_COMMENTS=false
# Keep these false unless a deliberate on-prem provider exception is required.
LLM_ALLOW_PRIVATE_ENDPOINTS=false
LLM_ALLOW_INSECURE_ENDPOINTS=false
# Comma-separated exact hostnames; required in production for Azure/custom proxies.
LLM_ALLOWED_PROVIDER_HOSTS=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_OVERALL_TIMEOUT_SECONDS=90
LLM_MAX_PROMPT_CHARS=32000
LLM_MAX_CONCURRENCY=4
LLM_PERSIST_METRICS=true
LLM_DAILY_TOKEN_BUDGET=500000
LLM_PROVIDER_REQUESTS_PER_MINUTE=120
LLM_PROVIDER_TOKENS_PER_MINUTE=250000
LLM_ENFORCE_PROVIDER_LIMITS=true
AI_PIPELINE_TIMEOUT_SECONDS=900
TICKET_EMBEDDING_MAX_COMMENTS_PER_REFRESH=50
AI_USER_REQUESTS_PER_MINUTE=10
AI_USER_REQUESTS_PER_DAY=200
AI_ANALYSIS_LEASE_SECONDS=1800
AI_ANALYSIS_MAX_ATTEMPTS=3
AI_METRICS_RETENTION_DAYS=30
AI_ARTIFACT_RETENTION_DAYS=90

# Database
DATABASE_URL=

# ITSM Integration
# standalone | freshservice | jira | none
ITSM_PROVIDER=
FRESHSERVICE_DOMAIN=
FRESHWORKS_ORG_DOMAIN=
FRESHSERVICE_API_KEY=
FRESHSERVICE_WORKSPACE_ID=
FRESHSERVICE_TICKET_INCLUDES=stats,requester
FRESHSERVICE_AGENT_STATE=
# OAuth 2.0 (Freshworks App SDK / marketplace recommended)
FRESHSERVICE_OAUTH_CLIENT_ID=
FRESHSERVICE_OAUTH_CLIENT_SECRET=
FRESHSERVICE_OAUTH_REDIRECT_URI=
FRESHSERVICE_OAUTH_SCOPES=freshservice.tickets.view freshservice.tickets.edit freshservice.agents.manage
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300
SYNC_INTERVAL_SECONDS=

# Frontend
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
FRONTEND_URL=

# AI automation (opt-in in every mode)
LLM_ALLOW_SYNTHETIC=false
AUTO_TRIAGE_ENABLED=
AUTO_SUMMARIZE_ENABLED=
AUTO_ROUTE_ENABLED=
AUTO_RESOLVE_ENABLED=
AUTO_SYSTEMIC_ENABLED=
SLA_P1_HOURS=4
SLA_P2_HOURS=24
SLA_P3_HOURS=72
SLA_P4_HOURS=168
