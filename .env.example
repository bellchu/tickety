# Runtime mode / security
# APP_MODE=demo keeps seeded demo data and no-login fallback available.
# APP_MODE=production requires explicit login sessions and fail-closed defaults.
APP_MODE=demo
SEED_DEMO_DATA=
CORS_ALLOW_ORIGINS=
COOKIE_SECURE=
COOKIE_SAMESITE=lax
SSO_ALLOWED_DOMAINS=
SSO_AUTO_PROVISION=false

# LLM
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
AZURE_AI_API_KEY=
AZURE_AI_API_BASE=
CUSTOM_API_KEY=
CUSTOM_API_BASE=
CUSTOM_PROVIDER_TYPE=
CUSTOM_API_VERSION=
CUSTOM_TEMPERATURE=
CUSTOM_MAX_TOKENS=
DEFAULT_MODEL=

# Database
DATABASE_URL=

# ITSM Integration
# standalone | freshservice | none
ITSM_PROVIDER=
FRESHSERVICE_DOMAIN=
FRESHWORKS_ORG_DOMAIN=
FRESHSERVICE_API_KEY=
# OAuth 2.0 (Freshworks App SDK / marketplace recommended)
FRESHSERVICE_OAUTH_CLIENT_ID=
FRESHSERVICE_OAUTH_CLIENT_SECRET=
FRESHSERVICE_OAUTH_REDIRECT_URI=
FRESHSERVICE_OAUTH_SCOPES=freshservice.tickets.view freshservice.tickets.edit
WEBHOOK_SECRET=
SYNC_INTERVAL_SECONDS=

# Frontend
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
FRONTEND_URL=

# AI automation
AUTO_TRIAGE_ENABLED=
AUTO_SUMMARIZE_ENABLED=
AUTO_ROUTE_ENABLED=
AUTO_RESOLVE_ENABLED=
AUTO_SYSTEMIC_ENABLED=
SLA_P1_HOURS=4
SLA_P2_HOURS=24
SLA_P3_HOURS=72
SLA_P4_HOURS=168
