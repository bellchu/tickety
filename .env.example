# Runtime mode / security
# APP_MODE=demo keeps seeded demo data and no-login fallback available.
# APP_MODE=production requires explicit login sessions and fail-closed defaults.
APP_MODE=demo
LOGIN_REQUIRED=false
TICKETY_ADMIN_SETTINGS_PORTAL_ENABLED=false
# Static deployment safety boundary for integration bindings. Use `poc` only
# on isolated proof-of-concept infrastructure; production is the safe default.
TICKETY_DEPLOYMENT_CLASS=production
SEED_DEMO_DATA=
CORS_ALLOW_ORIGINS=
# Optional Host-header allowlist for the API (comma-separated backend-visible
# hostnames, e.g. backend-service:8000). This validates the Host reaching the
# backend; use CORS_ALLOW_ORIGINS/FRONTEND_URL for browser public-origin checks.
TRUSTED_HOSTS=
# Set to true only when a trusted reverse proxy always overwrites
# X-Forwarded-Host / X-Forwarded-Proto before reaching the API.
TRUST_FORWARDED_HEADERS=false
COOKIE_SECURE=
COOKIE_SAMESITE=lax
MAX_REQUEST_BODY_BYTES=1048576
SSO_ALLOWED_DOMAINS=
SSO_ALLOWED_GROUP_IDS=
SSO_AUTO_PROVISION=false
SSO_ENABLED=false
# Provider preset: `entra`, `okta`, or a display name for generic OIDC.
SSO_PROVIDER=entra
# Entra preset: use the Directory (tenant) ID GUID. Multi-tenant authorities
# are intentionally rejected so Tickety cannot accept an unexpected tenant.
SSO_ENTRA_TENANT_ID=
# Okta preset: organization hostname such as company.okta.com. The built-in
# org authorization server is the simplest SSO default; set a custom server ID
# only when its claims or policies are required.
SSO_OKTA_DOMAIN=
SSO_OKTA_AUTH_SERVER_ID=org
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Generic OIDC only. Entra and Okta derive discovery from their preset fields.
SSO_DISCOVERY_URL=
# Optional override. Normally derived as FRONTEND_URL + /api/auth/sso/callback.
SSO_REDIRECT_URI=

# LLM
# Primary AI entry: Microsoft Foundry's OpenAI-compatible v1 endpoint.
FOUNDRY_API_BASE=https://<resource>.services.ai.azure.com/openai/v1
# api_key (default) or entra. Entra uses DefaultAzureCredential.
FOUNDRY_AUTH_METHOD=api_key
FOUNDRY_API_KEY=
# Optional second entry: a generic OpenAI-compatible Custom AI API.
CUSTOM_API_BASE=
CUSTOM_API_KEY=
DEFAULT_MODEL=foundry/DeepSeek-V4-Flash
# Ticket intelligence embeddings are opt-in to avoid surprise token spend.
# Requires pgvector-capable Postgres and an embedding-capable provider.
TICKET_EMBEDDING_ENABLED=false
TICKET_EMBEDDING_MODEL=foundry/text-embedding-3-small
TICKET_EMBEDDING_DIMENSIONS=1536
TICKET_EMBEDDING_TIMEOUT_SECONDS=30
TICKET_EMBEDDING_MAX_CHARS=32000
TICKET_VECTOR_MIN_SCORE=0.25
# Additive RAG v2 rollout controls. Enable writes first, then the dedicated
# worker, and enable reads only after shadow/canary gates pass.
TICKET_RAG_SCOPE_KEY=default
TICKET_RAG_V2_SCOPE_ALLOWLIST=default
TICKET_RAG_V2_WRITE_ENABLED=false
TICKET_RAG_V2_WORKER_ENABLED=false
TICKET_RAG_V2_READ_ENABLED=false
TICKET_RAG_CHUNK_TARGET_TOKENS=450
TICKET_RAG_CHUNK_MAX_TOKENS=600
TICKET_RAG_CHUNK_OVERLAP_TOKENS=50
TICKET_RAG_EMBED_BATCH_SIZE=32
TICKET_RAG_EMBED_LEASE_SECONDS=120
TICKET_RAG_WORKER_POLL_SECONDS=2
TICKET_RAG_QUERY_CACHE_TTL_SECONDS=2700
TICKET_RAG_QUERY_CACHE_MAX_ROWS=50000
TICKET_RAG_SNAPSHOT_TTL_SECONDS=86400
# Private/internal notes are excluded from external embeddings by default.
TICKET_INDEX_PRIVATE_COMMENTS=false
# Keep these false unless a deliberate on-prem provider exception is required.
LLM_ALLOW_PRIVATE_ENDPOINTS=false
LLM_ALLOW_INSECURE_ENDPOINTS=false
# Comma-separated exact hostnames; include the Foundry hostname in production.
LLM_ALLOWED_PROVIDER_HOSTS=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_OVERALL_TIMEOUT_SECONDS=90
LLM_MAX_PROMPT_CHARS=32000
LLM_MAX_CONCURRENCY=4
LLM_PERSIST_METRICS=true
LLM_DAILY_TOKEN_BUDGET=500000
LLM_PROVIDER_REQUESTS_PER_MINUTE=120
LLM_PROVIDER_TOKENS_PER_MINUTE=250000
LLM_ENFORCE_PROVIDER_LIMITS=true
AI_PIPELINE_TIMEOUT_SECONDS=900
# Maximum tickets (not provider calls) processed by each background sweep.
AI_BACKGROUND_TICKETS_PER_SWEEP=5
# Explicitly admit pre-existing active external tickets for triage + routing.
# The default preserves the realtime/seven-day automatic-AI boundary.
AI_ACTIVE_ROUTING_BACKLOG_ENABLED=false
TICKET_EMBEDDING_MAX_COMMENTS_PER_REFRESH=50
AI_USER_REQUESTS_PER_MINUTE=10
AI_USER_REQUESTS_PER_DAY=200
# Background work has its own admission ceiling; provider RPM/TPM and daily
# token budgets remain the authoritative aggregate limits.
AI_SYSTEM_REQUESTS_PER_MINUTE=10
AI_SYSTEM_REQUESTS_PER_DAY=2000
AI_ANALYSIS_LEASE_SECONDS=1800
AI_ANALYSIS_MAX_ATTEMPTS=3
AI_METRICS_RETENTION_DAYS=30
AI_ARTIFACT_RETENTION_DAYS=90

# Database
# Docker Compose supplies these demo-safe defaults on its private network.
# For production, generate an alphanumeric password and set DATABASE_URL with
# the same value (URL-encode passwords containing reserved characters). On an
# existing demo volume, rotate the database role first; see docs/deployment.md.
POSTGRES_USER=tickety
POSTGRES_PASSWORD=
POSTGRES_DB=tickety
POSTGRES_IMAGE=pgvector/pgvector:pg16
DATABASE_URL=

# ITSM Integration
# Blank defaults to standalone sample data in demo mode and to the Freshservice
# read-only sidecar in production. Set freshservice explicitly in deployments.
ITSM_PROVIDER=
FRESHSERVICE_DOMAIN=
FRESHWORKS_ORG_DOMAIN=
FRESHSERVICE_API_KEY=
FRESHSERVICE_WORKSPACE_ID=
FRESHSERVICE_TICKET_INCLUDES=requester
FRESHSERVICE_AGENT_STATE=
# Conservative defaults: automatic discovery is fixed to the latest 30 days.
# The old-ticket page limit is used only after an authenticated admin requests
# a 2-month, 3-month, or custom date range. Freshservice response headers
# remain authoritative; Tickety pauses before the shared budget is exhausted.
FRESHSERVICE_MIN_INTERVAL_SECONDS=1.6
FRESHSERVICE_RATE_LIMIT_RESERVE=10
FRESHSERVICE_RECENT_PAGES_PER_SYNC=2
FRESHSERVICE_HISTORY_PAGES_PER_SYNC=1
FRESHSERVICE_CONVERSATIONS_PER_SYNC=1
FRESHSERVICE_ATTACHMENTS_PER_SYNC=2

# Lossless Freshservice attachments. Keep the container private. Azure VMs
# should use a system-assigned managed identity with Storage Blob Data
# Contributor on this container (or the storage account); no account key is
# required. Service-principal AZURE_* credentials remain deployment-managed.
ATTACHMENT_STORAGE_PROVIDER=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=
ATTACHMENT_MAX_BYTES=52428800
# Shared only with the Freshworks secure installation parameter. Generate at
# least 32 random characters; never expose it through browser-readable config.
FRESHWORKS_APP_BOOTSTRAP_SECRET=
# OAuth 2.0 (Freshworks App SDK / marketplace recommended)
FRESHSERVICE_OAUTH_CLIENT_ID=
FRESHSERVICE_OAUTH_CLIENT_SECRET=
FRESHSERVICE_OAUTH_REDIRECT_URI=
FRESHSERVICE_OAUTH_SCOPES=freshservice.tickets.view freshservice.tickets.conversations.view freshservice.agents.manage freshservice.requesters.view
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300
SYNC_INTERVAL_SECONDS=

# Outbound email (also configurable by an authenticated administrator in the
# Settings page). SENDGRID_FROM_EMAIL must be an authenticated SendGrid sender.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Tickety
SENDGRID_REPLY_TO_EMAIL=
EMAIL_SENDS_PER_MINUTE=5
EMAIL_RECIPIENTS_PER_DAY=500

# Frontend
# Host port published by Docker Compose.
TICKETY_PORT=3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
FRONTEND_URL=

# AI automation (opt-in in every mode)
LLM_ALLOW_SYNTHETIC=false
AUTO_TRIAGE_ENABLED=
AUTO_SUMMARIZE_ENABLED=
AUTO_ROUTE_ENABLED=
AUTO_RESOLVE_ENABLED=
AUTO_SYSTEMIC_ENABLED=
SLA_P1_HOURS=4
SLA_P2_HOURS=24
SLA_P3_HOURS=72
SLA_P4_HOURS=168
