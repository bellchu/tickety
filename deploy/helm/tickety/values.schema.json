{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "existingSecret": { "type": "string" },
    "existingSecretRolloutToken": { "type": "string" },
    "imageDigestPolicy": {
      "type": "object",
      "properties": {
        "requireDigests": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["replicaCount", "topologySpread", "image", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": ["enabled", "shutdownDeadlineSeconds", "healthcheckMaxAgeSeconds", "image", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "shutdownDeadlineSeconds": { "type": "integer", "minimum": 5, "maximum": 30 },
        "healthcheckMaxAgeSeconds": { "type": "integer", "minimum": 30, "maximum": 600 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/definitions/ociDigest" },
            "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
          },
          "additionalProperties": false
        },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "required": ["replicaCount", "topologySpread", "image", "service", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "$ref": "#/definitions/stringMap" }
          },
          "additionalProperties": false
        },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "host", "path", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "host": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "tls": { "type": "array" }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["DATABASE_URL", "POSTGRES_PASSWORD"] }
      },
      "additionalProperties": { "type": "string" }
    },
    "config": {
      "type": "object",
      "required": ["appMode", "deploymentClass", "loginRequired", "frontendUrl", "corsAllowOrigins", "cookieSecure", "cookieSameSite", "sessionStorageMode", "notificationOutboxPollSeconds", "notificationOutboxBatchSize", "notificationOutboxReplayBatchSize", "notificationOutboxRetentionSeconds", "notificationOutboxPruneIntervalSeconds", "notificationOutboxStaleSeconds", "notificationOutboxPruneBatchSize", "notificationOutboxPruneBatchesPerRun", "aiRetentionCleanupBatchSize", "aiRetentionCleanupMaxRowsPerStart", "sso", "ragV2", "extra"],
      "properties": {
        "appMode": { "enum": ["demo", "production"] },
        "deploymentClass": { "enum": ["poc", "production"] },
        "loginRequired": { "type": "boolean" },
        "frontendUrl": { "type": "string" },
        "corsAllowOrigins": { "type": "string" },
        "cookieSecure": { "type": "boolean" },
        "cookieSameSite": { "enum": ["lax", "strict", "none"] },
        "sessionStorageMode": { "enum": ["auto", "compat", "hashed"] },
        "notificationOutboxPollSeconds": { "type": "integer", "minimum": 1, "maximum": 5 },
        "notificationOutboxBatchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "notificationOutboxReplayBatchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "notificationOutboxRetentionSeconds": { "type": "integer", "minimum": 300, "maximum": 86400 },
        "notificationOutboxPruneIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "notificationOutboxStaleSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "notificationOutboxPruneBatchSize": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "notificationOutboxPruneBatchesPerRun": { "type": "integer", "minimum": 1, "maximum": 20 },
        "aiRetentionCleanupBatchSize": { "type": "integer", "minimum": 10, "maximum": 5000 },
        "aiRetentionCleanupMaxRowsPerStart": { "type": "integer", "minimum": 10, "maximum": 50000 },
        "sso": {
          "type": "object",
          "required": [
            "enabled", "provider", "clientId", "entraTenantId",
            "oktaDomain", "oktaAuthServerId", "discoveryUrl",
            "allowedDomains", "allowedGroupIds", "autoProvision"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "enum": ["entra", "okta", "oidc"] },
            "clientId": { "type": "string" },
            "entraTenantId": {
              "type": "string",
              "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "oktaDomain": { "type": "string" },
            "oktaAuthServerId": { "type": "string", "minLength": 1 },
            "discoveryUrl": { "type": "string" },
            "allowedDomains": { "type": "string" },
            "allowedGroupIds": { "type": "string" },
            "autoProvision": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "ragV2": {
          "type": "object",
          "required": [
            "scopeKey", "scopeAllowlist", "writeEnabled", "workerEnabled",
            "readEnabled", "chunkTargetTokens", "chunkMaxTokens",
            "chunkOverlapTokens", "embedBatchSize", "embedLeaseSeconds",
            "workerPollSeconds", "queryCacheTtlSeconds", "queryCacheMaxRows",
            "snapshotTtlSeconds", "retentionPollSeconds"
          ],
          "properties": {
            "scopeKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
            "scopeAllowlist": { "type": "string", "minLength": 1 },
            "writeEnabled": { "type": "boolean" },
            "workerEnabled": { "type": "boolean" },
            "readEnabled": { "type": "boolean" },
            "chunkTargetTokens": { "type": "integer", "minimum": 100, "maximum": 1000 },
            "chunkMaxTokens": { "type": "integer", "minimum": 100, "maximum": 1500 },
            "chunkOverlapTokens": { "type": "integer", "minimum": 0, "maximum": 200 },
            "embedBatchSize": { "type": "integer", "minimum": 1, "maximum": 32 },
            "embedLeaseSeconds": { "type": "integer", "minimum": 30, "maximum": 900 },
            "workerPollSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "queryCacheTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "queryCacheMaxRows": { "type": "integer", "minimum": 100, "maximum": 1000000 },
            "snapshotTtlSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "retentionPollSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 }
          },
          "additionalProperties": false
        },
        "extra": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              { "pattern": "^[A-Z][A-Z0-9_]*$" },
              { "not": { "enum": [
                "APP_MODE",
                "TICKETY_DEPLOYMENT_CLASS",
                "LOGIN_REQUIRED",
                "FRONTEND_URL",
                "CORS_ALLOW_ORIGINS",
                "COOKIE_SECURE",
                "COOKIE_SAMESITE",
                "SSO_ENABLED",
                "SSO_PROVIDER",
                "SSO_CLIENT_ID",
                "SSO_ENTRA_TENANT_ID",
                "SSO_OKTA_DOMAIN",
                "SSO_OKTA_AUTH_SERVER_ID",
                "SSO_DISCOVERY_URL",
                "SSO_REDIRECT_URI",
                "SSO_ALLOWED_DOMAINS",
                "SSO_ALLOWED_GROUP_IDS",
                "SSO_AUTO_PROVISION",
                "NOTIFICATION_OUTBOX_POLL_SECONDS",
                "NOTIFICATION_OUTBOX_BATCH_SIZE",
                "NOTIFICATION_OUTBOX_REPLAY_BATCH_SIZE",
                "NOTIFICATION_OUTBOX_RETENTION_SECONDS",
                "NOTIFICATION_OUTBOX_PRUNE_INTERVAL_SECONDS",
                "NOTIFICATION_OUTBOX_STALE_SECONDS",
                "NOTIFICATION_OUTBOX_PRUNE_BATCH_SIZE",
                "NOTIFICATION_OUTBOX_PRUNE_BATCHES_PER_RUN",
                "AI_RETENTION_CLEANUP_BATCH_SIZE",
                "AI_RETENTION_CLEANUP_MAX_ROWS_PER_START",
                "DATABASE_URL",
                "POSTGRES_PASSWORD"
              ] } },
              { "not": { "pattern": "^TICKETY_SETTINGS_ENCRYPTION_" } },
              { "not": { "pattern": "(?i)(^|_)(API_?KEY|KEYS?|SECRETS?|TOKENS?|PASSWORDS?|CREDENTIALS?|CONNECTION(_STRING)?|PRIVATE|CERT(IFICATE)?S?)(_|$)" } }
            ]
          },
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "image", "auth", "externalDatabaseUrl", "persistence", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/postgresqlImage" },
        "auth": {
          "type": "object",
          "required": ["username", "password", "database"],
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "database": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "externalDatabaseUrl": { "type": "string" },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size", "storageClass"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "required": ["activeDeadlineSeconds", "backoffLimit", "resources"],
      "properties": {
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "required": [
        "enabled",
        "schedule",
        "retentionDays",
        "activeDeadlineSeconds",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "persistence",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "persistence": {
          "type": "object",
          "required": ["size", "storageClass", "existingClaim"],
          "properties": {
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string" },
            "existingClaim": { "type": "string" }
          },
          "additionalProperties": false
        },
        "resources": { "$ref": "#/definitions/resourceRequirements" }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "allowPublicHttpsEgress", "additionalEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowPublicHttpsEgress": { "type": "boolean" },
        "additionalEgress": { "type": "array" }
      },
      "additionalProperties": false
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": { "appMode": { "const": "production" } }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "loginRequired": { "const": true },
              "cookieSecure": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": { "cookieSameSite": { "const": "none" } }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": { "cookieSecure": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backup": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        }
      },
      "then": {
        "properties": {
          "postgresql": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        }
      }
    }
  ],
  "definitions": {
    "ociDigest": {
      "type": "string",
      "pattern": "^$|^sha256:[a-f0-9]{64}$"
    },
    "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^[lL][aA][tT][eE][sS][tT]$" }
        },
        "digest": { "$ref": "#/definitions/ociDigest" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      },
      "additionalProperties": false
    },
    "topologySpread": {
      "type": "object",
      "required": ["enabled", "topologyKey", "maxSkew", "whenUnsatisfiable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "topologyKey": { "type": "string", "minLength": 1 },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
      },
      "additionalProperties": false
    },
    "postgresqlImage": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(latest|pg[0-9]+)$" }
        },
        "digest": { "$ref": "#/definitions/ociDigest" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      },
      "additionalProperties": false
    },
    "quantityMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "resourceRequirements": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/quantityMap" },
        "limits": { "$ref": "#/definitions/quantityMap" }
      },
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
