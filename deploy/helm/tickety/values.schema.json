{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "existingSecret": { "type": "string" },
    "backend": {
      "type": "object",
      "required": ["replicaCount", "image"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "worker": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["replicaCount", "image", "service"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host", "path", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "tls": { "type": "array" }
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["DATABASE_URL", "POSTGRES_PASSWORD"] }
      },
      "additionalProperties": { "type": "string" }
    },
    "config": {
      "type": "object",
      "required": ["appMode", "loginRequired", "cookieSecure", "cookieSameSite", "extra"],
      "properties": {
        "appMode": { "enum": ["demo", "production"] },
        "seedDemoData": { "type": "string" },
        "loginRequired": { "type": "boolean" },
        "frontendUrl": { "type": "string" },
        "corsAllowOrigins": { "type": "string" },
        "cookieSecure": { "type": "boolean" },
        "cookieSameSite": { "enum": ["lax", "strict", "none"] },
        "extra": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "APP_MODE",
                "SEED_DEMO_DATA",
                "LOGIN_REQUIRED",
                "FRONTEND_URL",
                "CORS_ALLOW_ORIGINS",
                "COOKIE_SECURE",
                "COOKIE_SAMESITE",
                "DATABASE_URL",
                "POSTGRES_PASSWORD"
              ]
            }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "image", "auth", "externalDatabaseUrl", "persistence"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "required": ["username", "password", "database"],
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "database": { "type": "string", "minLength": 1 }
          }
        },
        "externalDatabaseUrl": { "type": "string" },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size", "storageClass"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "allowPublicHttpsEgress", "additionalEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowPublicHttpsEgress": { "type": "boolean" },
        "additionalEgress": { "type": "array" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": { "appMode": { "const": "production" } }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "loginRequired": { "const": true },
              "cookieSecure": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "config": {
            "properties": { "cookieSameSite": { "const": "none" } }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": { "cookieSecure": { "const": true } }
          }
        }
      }
    }
  ],
  "definitions": {
    "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
      }
    }
  }
}
